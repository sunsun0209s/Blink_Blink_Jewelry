<Window x:Class="BlinkBlink.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ucIdentity="clr-namespace:BlinkBlink.Admin.Views.UserControls.Identity"
        mc:Ignorable="d"
        Title="Blink Blink Jewelry - Hệ Thống Quản Lý Bán Trang Sức (Admin &amp; POS)" 
        Height="780" Width="1200" WindowStartupLocation="CenterScreen">
    
    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh Topbar -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💎" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="BLINK BLINK JEWELRY" FontSize="18" FontWeight="Bold" Foreground="#C5A059" VerticalAlignment="Center"/>
                    <TextBlock Text=" | HỆ THỐNG QUẢN TRỊ &amp; BÁN HÀNG" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#333333" CornerRadius="15" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="XuanTam (Phân quyền Quản trị)" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Khu vực Tab Navigation phân hệ theo UserControls -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">
            <!-- Tab Quản lý nhân viên (Phân hệ Người dùng & Phân quyền - XuanTam) -->
            <TabItem Header="👥 Quản lý Nhân sự &amp; Phân quyền" FontSize="13" FontWeight="SemiBold" Padding="15,8">
                <ucIdentity:UC_NhanVien x:Name="ucNhanVien"/>
            </TabItem>

            <!-- Các Tab khác sẵn sàng cho các thành viên trong nhóm tích hợp -->
            <TabItem Header="🛒 Bán hàng POS" FontSize="13" Padding="15,8">
                <Border Background="White" Margin="15" CornerRadius="8" Padding="30">
                    <TextBlock Text="Màn hình Bán hàng POS (UC_BanHangPOS - Phân hệ Bán hàng) sẵn sàng tích hợp." 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#888"/>
                </Border>
            </TabItem>

            <TabItem Header="💍 Quản lý Trang sức" FontSize="13" Padding="15,8">
                <Border Background="White" Margin="15" CornerRadius="8" Padding="30">
                    <TextBlock Text="Màn hình Quản lý Sản phẩm (UC_SanPham - Phân hệ Sản phẩm &amp; Kho) sẵn sàng tích hợp." 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#888"/>
                </Border>
            </TabItem>

            <TabItem Header="📦 Kho hàng" FontSize="13" Padding="15,8">
                <Border Background="White" Margin="15" CornerRadius="8" Padding="30">
                    <TextBlock Text="Màn hình Nhập kho &amp; Kiểm kê (UC_NhapKho, UC_KiemKe) sẵn sàng tích hợp." 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#888"/>
                </Border>
            </TabItem>

            <TabItem Header="🛠️ Dịch vụ &amp; Bảo hành" FontSize="13" Padding="15,8">
                <Border Background="White" Margin="15" CornerRadius="8" Padding="30">
                    <TextBlock Text="Màn hình Tiếp nhận Bảo hành (UC_BaoHanh) sẵn sàng tích hợp." 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#888"/>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
