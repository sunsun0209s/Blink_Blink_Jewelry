@model BlinkBlink.Application.DTOs.Identity.DangKyKhachHangDTO

@{
    ViewData["Title"] = "Đăng ký thành viên mới";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-dark text-center py-4 rounded-top-4 border-0">
                <div class="mb-2">
                    <i class="bi bi-person-plus text-warning display-5"></i>
                </div>
                <h4 class="text-white fw-bold mb-0">ĐĂNG KÝ THÀNH VIÊN</h4>
                <p class="text-white-50 small mb-0">Trở thành khách hàng thân thiết của Blink Blink Jewelry</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-controller="KhachHang" asp-action="DangKy" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="HoTen" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                        </div>
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="0901234567" required />
                            </div>
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NgaySinh" class="form-label fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar"></i></span>
                                <input asp-for="NgaySinh" type="date" class="form-control" required />
                            </div>
                            <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-at"></i></span>
                            <input asp-for="TenDangNhap" class="form-control" placeholder="Chọn tên đăng nhập viết liền" required />
                        </div>
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="MatKhau" class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-shield-lock"></i></span>
                            <input asp-for="MatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu an toàn" required />
                        </div>
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-bb-gold py-2 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Hoàn tất đăng ký
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <span class="text-muted small">Đã có tài khoản?</span>
                        <a asp-controller="XacThuc" asp-action="DangNhap" class="text-decoration-none fw-semibold text-warning"> Đăng nhập tại đây</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
